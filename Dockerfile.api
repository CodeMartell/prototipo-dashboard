FROM python:3.12-slim

# Variáveis de ambiente para performance e buffering do Python
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    API_PORT=5001

WORKDIR /app

# Dependências de sistema (curl usado no healthcheck)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Dependências Python — instala a partir do requirements.txt do backend FastAPI
COPY server/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Código-fonte do backend FastAPI
COPY server ./

# Script de entrada: aplica migrations + seed antes de subir o servidor
COPY docker-entrypoint-api.sh /app/docker-entrypoint-api.sh
RUN chmod +x /app/docker-entrypoint-api.sh

# Cria usuário não-root (boas práticas de segurança)
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app
USER appuser

EXPOSE 5001

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:5001/api/health || exit 1

ENTRYPOINT ["/app/docker-entrypoint-api.sh"]
