# ==========================================================
# CONFIGURAÇÕES DO BOT EXTRATOR DE E-MAILS (ÉPICO 3 - DXI)
# ==========================================================

# Modo de Execução: 'SIMULATION' (Demonstrações/Offline) ou 'REAL' (Conexão IMAP/SMTP ativa)
EXECUTION_MODE=SIMULATION

# Conexão IMAP (Leitura de E-mails)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_MAILBOX=INBOX

# Conexão SMTP (Envio de Relatórios Executivos)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Credenciais
EMAIL_USER=seu_email@empresa.com
EMAIL_PASS_TOKEN=sua_senha_de_aplicativo_ou_token

# Notificação do Gestor
ENVIAR_RELATORIO_GESTOR=true
EMAIL_GESTOR_DESTINO=gestor.logistica@empresa.com
