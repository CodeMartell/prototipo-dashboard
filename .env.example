# ==============================================================================
# CONFIGURAÇÕES GERAIS DO PROJETO - DATALENS / PROTÓTIPO DASHBOARD
# Copie este arquivo para .env na raiz antes de executar (docker compose up).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Banco de Dados PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_DB=dashboard
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=dashboard
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Servidor API Backend (FastAPI — server/)
# ------------------------------------------------------------------------------
API_PORT=5001
ENVIRONMENT=production

# OBRIGATÓRIO: troque por um valor seguro antes de subir de verdade
# (nunca reaproveite o valor de exemplo em produção)
JWT_SECRET=senha1234
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480

# Origem liberada no CORS — endereço público do frontend
FRONTEND_ORIGIN=http://localhost:5173

# Opcional: se preenchidos, o container da API cria esse usuário admin
# automaticamente no primeiro start (idempotente — não duplica se já existir)
ADMIN_EMAIL=teste@gmail.com
ADMIN_PASSWORD=senha123
ADMIN_NAME=Admin

# ------------------------------------------------------------------------------
# 3. Frontend Dashboard (React + Nginx)
# ------------------------------------------------------------------------------
FRONTEND_PORT=80

# ------------------------------------------------------------------------------
# 4. Robô de Automação de E-mails (RPA)
# ------------------------------------------------------------------------------
EMAIL_USER=seu_email@empresa.com
EMAIL_PASSWORD=sua_senha_de_aplicativo_aqui
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_MAILBOX=INBOX

EMAIL_SUBJECT_FILTER=Relatorio Logistico
EMAIL_SENDER_FILTER=
EMAIL_DATE_FROM=2026-01-01
EMAIL_DATE_TO=2026-12-31

# Diretório para armazenamento de anexos extraídos (opcional)
ATTACHMENTS_DIR=rpa_email/resources/attachments
