# Configuracao do frontend. Copie para .env.local (nao versionado) e ajuste.
# Em producao com Docker nada disso e necessario: o nginx do container ja
# faz proxy de /api para a API.

# ------------------------------------------------------------------------------
# Opcao 1 (recomendada em dev) — proxy do dev server
# O browser chama /api na propria origem e o Vite encaminha. Sem CORS.
# ------------------------------------------------------------------------------
VITE_API_PROXY_TARGET=http://localhost:5001

# ------------------------------------------------------------------------------
# Opcao 2 — chamadas absolutas, quando o frontend e servido sem proxy
# Aqui o CORS passa a valer: inclua a origem do frontend em FRONTEND_ORIGIN
# no .env do backend (aceita lista separada por virgula).
# ------------------------------------------------------------------------------
# VITE_API_URL=http://10.194.175.88:5001

# Host do dev server. 0.0.0.0 expoe na rede local.
# VITE_DEV_HOST=127.0.0.1
