# ==============================================================================
# CONFIGURAÇÕES GERAIS DO PROJETO - DATALENS / PROTÓTIPO DASHBOARD
# Copie este arquivo para .env na raiz antes de executar.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Banco de Dados PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_DB=dashboard
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=dashboard
# Porta exposta no host para outros servicos acessarem o banco.
# Se a maquina ja tiver um PostgreSQL local na 5432, troque para 5433.
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Servidor API Backend (FastAPI)
# ------------------------------------------------------------------------------
API_PORT=5001
ENVIRONMENT=development
JWT_SECRET=troque-por-um-segredo-local-longo-e-aleatorio
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480
# Origem do frontend (usada no CORS). Com o compose completo, o frontend
# roda em http://localhost:8080. Aceita lista separada por virgula.
FRONTEND_ORIGIN=http://localhost:8080
# Regex opcional para origens dinamicas (ex.: previews da Vercel). Vazio = off.
FRONTEND_ORIGIN_REGEX=

# Conta inicial (perfil ADMIN), criada no primeiro start.
# NAO use dominio .local: o validador de e-mail rejeita TLDs reservados e o
# login falha com HTTP 422. Prefira um dominio real ou "example.com".
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha-local
ADMIN_NAME=Admin

# ------------------------------------------------------------------------------
# 3. Frontend Dashboard (React + Nginx)
# ------------------------------------------------------------------------------
# Porta do dashboard no host. Acesse em http://localhost:8080.
FRONTEND_PORT=8080

# ------------------------------------------------------------------------------
# 4. Robô de Automação de E-mails (RPA)
# ------------------------------------------------------------------------------
EMAIL_USER=seu_email@empresa.com
EMAIL_PASSWORD=sua_senha_de_aplicativo_aqui
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_MAILBOX=INBOX

EMAIL_SUBJECT_FILTER=Relatorio Logistico
EMAIL_SENDER_FILTER=
EMAIL_DATE_FROM=2026-01-01
EMAIL_DATE_TO=2026-12-31

# Diretório para armazenamento de anexos extraídos (opcional)
ATTACHMENTS_DIR=rpa_email/resources/attachments

# Ingestão do bot principal via FastAPI (credenciais DIFERENTES das do Gmail).
# Configure somente para o ambiente desejado; não executar com valores de exemplo.
RPA_API_URL=http://localhost:5001
RPA_API_EMAIL=bot.local@example.com
RPA_API_PASSWORD=troque-esta-senha-local
RPA_API_TIMEOUT=20
RPA_HISTORY_PATH=rpa_email/resources/api_email_history.db

# O dashboard nao tem mais fallback de dados locais: sem API, a tela fica
# vazia em vez de exibir numeros de exemplo.
