# ============================================================
# DataLens — variáveis de ambiente
# NUNCA versione o arquivo .env real. Use este como referência.
# ============================================================

# --- Credenciais de e-mail (preencher manualmente) ---
EMAIL_USER=sua_conta@gmail.com
EMAIL_PASSWORD=senha_de_aplicativo_google
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_MAILBOX=INBOX

# --- Filtros do bot de e-mail ---
EMAIL_SUBJECT_FILTER=Relatorio Logistico
EMAIL_SENDER_FILTER=remetente@empresa.com
EMAIL_DATE_FROM=2026-01-01
EMAIL_DATE_TO=2026-12-31

# --- Banco de dados PostgreSQL ---
DATABASE_URL=postgresql://dashboard:dashboard@localhost:5432/dashboard

# --- Caminhos locais (relativos à raiz do projeto) ---
# Pasta onde o bot salva os anexos recebidos por e-mail
ATTACHMENTS_DIR=rpa_email/resources/attachments
# Pasta contendo as planilhas KPI para o bot local
KPI_REPORTS_DIR=kpi_reports
# Caminho do cache local Excel (gerado automaticamente pelo bot)
EXCEL_OUTPUT_PATH=dados_dashboard.xlsx
# Porta do servidor API (FastAPI)
API_PORT=5001
